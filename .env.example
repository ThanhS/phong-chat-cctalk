# Copy thành .env rồi ĐỔI key/secret trước khi chạy online:
#   cp .env.example .env
# Sinh key/secret mới bằng 1 trong 2 cách:
#   docker run --rm livekit/livekit-server:v1.13.10 generate-keys
#   openssl rand -hex 10   (key)  /  openssl rand -hex 32   (secret)
# Các giá trị dưới đây chỉ là VÍ DỤ — không dùng nguyên cho server thật.

# API key/secret dùng chung cho LiveKit server (qua LIVEKIT_KEYS) và token-server.
LIVEKIT_API_KEY=APe6108c8332448bf40c8b
LIVEKIT_API_SECRET=d0d7433bb8434df6153a3015c25eb3deebd316b6d4ef3f5194616b9ade382110

# URL client (trình duyệt) dùng để nối LiveKit.
# Test trên máy mình: ws://localhost:7880
# Chạy online tự host: wss://voice.example.com  (đổi example.com thành domain thật)
# Dùng LiveKit Cloud: wss://xxx-xxxx.livekit.cloud  (URL trong dashboard Cloud)
LIVEKIT_URL=ws://localhost:7880

# Token sống bao lâu (mặc định 6h; vd: 2h, 1h).
TOKEN_TTL=6h

# --- Đăng nhập phía máy chủ (v2) ---
# Secret ký session đăng nhập — SINH MỚI, KHÔNG dùng giá trị ví dụ:
#   openssl rand -hex 32
# Đổi secret là mọi phiên đăng nhập cũ hết hiệu lực ngay.
SESSION_SECRET=
# Session đăng nhập sống bao lâu (mặc định 6h).
SESSION_TTL=6h
# Chế độ cũ: /token chấp nhận identity/rank do client gửi (KHÔNG an toàn).
# Mặc định 0 (tắt). Chỉ bật =1 lúc chuyển đổi từ bản cũ.
ALLOW_LEGACY_TOKEN=0
# Mật khẩu gieo tài khoản demo ở lần khởi động đầu tiên (khi chưa có
# data/users.json). Đặt mật khẩu MẠNH khi chạy online; file .env này
# không bao giờ commit. Đổi mật khẩu sau khi đã gieo thì dùng:
#   docker compose exec token-server node add-user.js <id> <mật khẩu mới> [rank]
#   (hoặc chạy node add-user.js trực tiếp trên máy chủ)
ADMIN_PASSWORD=
BDH_PASSWORD=
THANH_PASSWORD=
TEST_PASSWORD=

# (Không bắt buộc) Secret bảo vệ endpoint /stage — xem README mục "Giới hạn".
# Nếu đặt, front-end phải gửi header x-stage-secret khi báo ai đang trên mic.
STAGE_SECRET=

# (Không bắt buộc) Origin được phép gọi token-server. Mặc định * để test;
# chạy online nên ghi rõ domain trang chat, vd: https://chat.example.com
CORS_ORIGIN=*

# --- Lưu trữ bền bằng Postgres/Neon (v3.6, không bắt buộc) ---
# Đặt chuỗi kết nối Postgres của Neon (project vùng Singapore, lấy trong
# dashboard Neon) thì tài khoản/điểm/phòng tự tạo lưu bền trên Neon,
# không mất khi máy chủ khởi động lại. Để trống = lưu file data/users.json
# như cũ. KHÔNG commit chuỗi thật (nó chứa mật khẩu).
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
